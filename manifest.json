{
  "manifest_version": 3,
  "name": "Giaoculator S",
  "version": "0.65",
  "description": "Giaoculator S: Easy GPA calculation for Schoolis.cn. Integrates with Xiaobao and track your progress effortlessly.",
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "13f429db-81e8-4b32-8f48-e68f0adb25e1",
    "scopes": [
      "User.Read",
      "EduAssignments.Read.All",
      "email",
      "profile",
      "openid",
      "EduRoster.ReadBasic",
      "EduAssignments.Read"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://*.schoolis.cn/*", "*://4.3.2.1/*", "*://view.officeapps.live.com/*"],
      "css": ["lib/notyf.min.css"],
      "js": ["lib/notyf.min.js", "lib/confetti.browser.min.js", "content.js"]
    },
    {
      "matches": ["*://www.savemyexams.com/*"],
      "css": ["lib/notyf.min.css"],
      "js": ["lib/notyf.min.js", "lib/confetti.browser.min.js", "content_sme.js"]
    },
    {
      "matches": ["https://*.schoolis.cn/*", "*://4.3.2.1/*", "*://view.officeapps.live.com/*"],
      "js": ["content_preload.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "iconV2.png",
    "48": "iconV2.png",
    "128": "iconV2.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png",
        "iconV2.png",
        "res/disablev2.png",
        "res/disable.png",
        "res/icon.png",
        "res/iconBig_teamsAcc.png",
        "res/hideOff.svg",
        "res/hideOn.svg",
        "res/hideOff_Dark.svg",
        "res/hideOn_Dark.svg",
        "res/visOn.svg",
        "res/visOff.svg",
        "res/ball_settings.png",
        "res/exp_settings.png",
        "res/tsLogo_W.png",
        "res/tsLogo_D.png",
        "res/download.svg",
        "res/settings.svg",
        "res/green-tick.png",
        "res/questionMark.svg",
        "res/colored_bg.jpg",
        "res/inwindow-popup.css",
        "res/msteamsLogo.svg",
        "res/iconBig_foot.png",
        "res/clockIcon.png",
        "teamsPanel.html",
        "res/refresh.svg",
        "res/fonts/MaterialSymbolsOutlined.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": "iconV2.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "unlimitedStorage",
    "identity"
  ],
  "host_permissions": ["https://*.schoolis.cn/*", "*://4.3.2.1/*", "*://view.officeapps.live.com/*"]
}
